<launch>
  <node name="realsense_driver" pkg="usb_cam" type="usb_cam_node" output="screen" ns="camera">
    <param name="video_device" value="/dev/video6" /> 
    <param name="image_width" value="640" /> <!-- check ls /dev/device* -->
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="camera_link" />
    </node>

  <node name="gelsight_driver" pkg="usb_cam" type="usb_cam_node" output="screen" ns="gelsight">
    <param name="video_device" value="/dev/video4" /> <!-- check ls /dev/device* -->
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="mjpeg" /> <param name="framerate" value="30" />
    <param name="camera_frame_id" value="gelsight_link" />
  </node>
</launch>