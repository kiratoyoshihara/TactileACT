<launch>
  <node name="camera_top_driver" pkg="usb_cam" type="usb_cam_node" output="screen" ns="camera_top">
    <param name="video_device" value="/dev/video6" /> <param name="image_width" value="640" /> <!-- check here -->
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="camera_top_link" />
  </node>

  <node name="camera_side_driver" pkg="usb_cam" type="usb_cam_node" output="screen" ns="camera_side">
    <param name="video_device" value="/dev/video8" /> <param name="image_width" value="640" /> <!-- check here -->
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="camera_side_link" />
  </node>

  <node name="gelsight_driver" pkg="usb_cam" type="usb_cam_node" output="screen" ns="gelsight">
    <param name="video_device" value="/dev/video4" /> <!-- check here -->
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="mjpeg" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="gelsight_link" />
  </node>
</launch>