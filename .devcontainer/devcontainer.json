{
    "name": "ROS 1 Noetic Dev (TactileACT)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "options": {
            "noCache": true
        },
    },
    "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python"
    ],
    "runArgs": [
        "--net=host", 
        "--privileged",
        "--env=DISPLAY",
        "--env=QT_X11_NO_MITSHM=1"
        // "--gpus", "all" 
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/mnt/wslg,target=/mnt/wslg,type=bind,consistency=cached"
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/catkin_ws/src/TactileACT,type=bind",
    "workspaceFolder": "/root/catkin_ws/src/TactileACT"
}